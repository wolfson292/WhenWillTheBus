<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Production APNs. Pair with Apns__UseSandbox=false on the worker. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- The app and the widget extension share a container through this group,
	     because a widget has no network and no engine: the app leaves it a
	     snapshot to draw. Both sides must carry the same identifier, and it must
	     exist on the App ID or the entitlement is silently stripped. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.denlair.whenwillthebus</string>
	</array>
</dict>
</plist>
