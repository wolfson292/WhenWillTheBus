<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- iOS only. The prediction engine is platform-agnostic and also runs on
         the server; this project is the phone. -->
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- LibraryImport generates unsafe marshalling code for the ActivityKit
         bridge. None of our own code is unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The HOME SCREEN label, not the App Store listing (which is set in App
         Store Connect). iOS renders "When Will The Bus" under the icon as an
         unspaced "WhenWillTheBus", and the short word is the one a parent's
         thumb is hunting for anyway. -->
    <ApplicationTitle>Bus</ApplicationTitle>

    <!-- ApplicationId comes from Directory.Build.props at the repository root,
         which is the single place it is defined. -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- ActivityKit needs 16.2; Live Activities are the reason for this app. -->
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>

  </PropertyGroup>

  <!-- The push entitlement, without which ActivityKit never issues an activity
       push token and the worker can never update a suspended card. Development
       and production APNs are different environments: a token from one is
       rejected outright by the other, and the rejection is silent. -->
  <!-- DEVICE BUILDS ONLY. The simulator neither needs nor can sign entitlements,
       and asking it to turns a working simulator build into "No valid iOS code
       signing keys found in keychain".
       
       These are deliberately NOT called Entitlements.plist: the iOS SDK picks
       that name up by convention and applies it to every build, including the
       simulator, whatever conditions you write. Naming them otherwise is what
       keeps this a choice rather than a default. -->
  <!-- Which APNs environment the app claims. This follows the PROVISIONING, not
       the build configuration: a Release build signed with a DEVELOPMENT profile
       is still a development app, and claiming 'production' against a profile
       that grants 'development' is an install failure at best and a silently
       undeliverable push at worst. Distribution builds pass
       -p:ApnsEnvironment=production explicitly. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'ios-arm64'">
    <ApnsEnvironment Condition="'$(ApnsEnvironment)' == ''">development</ApnsEnvironment>
    <CodesignEntitlements Condition="'$(ApnsEnvironment)' == 'production'">Platforms/iOS/Entitlements.Device.Production.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(ApnsEnvironment)' != 'production'">Platforms/iOS/Entitlements.Device.Development.plist</CodesignEntitlements>

    <!-- THE APP HAS TO TELL THE WORKER WHICH ENVIRONMENT ITS TOKEN CAME FROM.
         One worker serves a TestFlight household alongside a development phone,
         and it picks the APNs host per activity from what the app reported at
         registration (ServerLink.RegisterActivityAsync, DeviceIdentity.Environment).

         Both of those read #if APNS_PRODUCTION. Without this line nothing ever
         defines it, so a TestFlight build claims "sandbox", the worker pushes
         its production tokens to api.sandbox.push.apple.com, and Apple drops
         them — no error on the worker, no card on the phone.

         It sits beside CodesignEntitlements deliberately: the entitlement
         decides which environment the token is MINTED in, this decides which
         one the app CLAIMS, and the two disagreeing is undebuggable. -->
    <DefineConstants Condition="'$(ApnsEnvironment)' == 'production'">$(DefineConstants);APNS_PRODUCTION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />

    <!-- MapKit on iOS, so no API key is needed. Android would want one. -->
    <PackageReference Include="Microsoft.Maui.Controls.Maps" Version="10.0.20" />
  </ItemGroup>

  <ItemGroup>
    <!-- NO MauiIcon. It rasterises one SVG into one appearance and offers no way
         to add the other two, so an app built through it shows the same bright
         yellow tile on a dark home screen at night and ignores a tint its owner
         chose. The appiconset below is owned by hand for that reason;
         Resources/AppIcon/appicon.svg stays as the readable source of the
         geometry, and scripts/build-app-icons.swift draws all three from it.

         The catalog needs no item here: unlike MauiImage, ImageAsset IS globbed
         by default, and the default strips the Platforms/iOS prefix from the
         logical name — which is the name XSAppIconAssets in
         Platforms/iOS/Info.plist has to match. Adding an explicit include gives
         the same file a second, longer logical name and earns an MT7158 for
         every file in the set.

         Those two must agree: point XSAppIconAssets at a set that is not in the
         build and the app ships with no icon at all, which App Store Connect
         rejects after the upload. -->

    <!-- Color must match the ground baked into appicon.svg (#0E1117), because
         the splash mark is drawn without one and cuts straight through to this.
         Two shades of almost-black read as a flicker on launch. -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0E1117" BaseSize="176,176" />

    <!-- Tab-bar icons. Declared explicitly: EnableDefaultMauiItems is true here
         and the SDK still globs nothing into MauiImage, so leaving this to the
         defaults produces no imagesets, no build error, and a tab bar that
         quietly renders as text only. To check what is actually included, run
         dotnet build on this project asking for the MauiImage item group with
         the getItem switch. -->
    <MauiImage Include="Resources\Images\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhenWillTheBus.Core\WhenWillTheBus.Core.csproj" />
  </ItemGroup>

  <!-- The Swift bridge and the widget extension, built by
       scripts/build-ios-native.sh. See docs/ios-build.md: WidgetKit UI cannot be
       written in C#, so this is the one native piece. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\ios\build\WhenWillTheBusNative.xcframework')">
    <NativeReference Include="..\..\ios\build\WhenWillTheBusNative.xcframework">
      <Kind>Framework</Kind>
      <ForceLoad>True</ForceLoad>
    </NativeReference>
  </ItemGroup>

</Project>
