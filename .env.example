# SPDX-License-Identifier: GPL-3.0-or-later
# Copy to .env and fill in. .env is gitignored and must stay that way.

# A long random string. Generate with: openssl rand -base64 32
WWTB_API_KEY=

# The WheresTheBus parent account.
WTB_EMAIL=
WTB_PASSWORD=
# Invent one stable identifier and keep it. Changing it makes every start look
# like a new device to the server. Generate with: uuidgen
WTB_DEVICE_ID=
WTB_TIMEZONE=America/New_York

# From the Apple Developer portal. The .p8 itself goes in ./secrets/AuthKey.p8.
APNS_KEY_ID=
APNS_TEAM_ID=
# Must match ApplicationId in Directory.Build.props -- run scripts/print-config.sh
APNS_BUNDLE_ID=com.denlair.whenwillthebus
# FALLBACK ONLY, for a registration that did not name its environment -- an app
# built before that field existed. The worker otherwise picks the APNs host per
# activity from what each app reported, so one worker serves a development phone
# and a TestFlight household at the same time and this setting breaks neither.
APNS_SANDBOX=false
